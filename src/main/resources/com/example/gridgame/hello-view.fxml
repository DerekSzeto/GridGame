                  <Label fx:id="pieceSelectedLabel" layoutX="885.0" layoutY="195.0" prefHeight="27.0" prefWidth="188.0" />
                  <ListView fx:id="playerClickableListView" layoutX="881.0" layoutY="284.0" prefHeight="123.0" prefWidth="192.0" />
                  <Label fx:id="clickableSelectedLabel" layoutX="7.0" layoutY="320.0">
