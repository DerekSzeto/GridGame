<TabPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="900.0" minWidth="1080.0" prefHeight="400.0" prefWidth="600.0" tabClosingPolicy="UNAVAILABLE" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.gridgame.HelloController">
